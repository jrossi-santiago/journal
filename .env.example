# Google Cloud OAuth client (Web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client.
# Local dev: http://localhost:3000/api/auth/callback
# Production: https://<your-vercel-domain>/api/auth/callback
GOOGLE_REDIRECT_URI=

# Google Drive folder to save into. Use the bare folder ID — the string after
# /folders/ in the URL, e.g. 1AbC2dEfGhIjK — not the full URL. (A pasted
# folder URL is accepted too and the ID is extracted from it.)
DRIVE_FOLDER_ID=

# Vercel KV (Upstash Redis) — auto-injected when you add the KV integration
# in the Vercel dashboard. Only needed manually for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
